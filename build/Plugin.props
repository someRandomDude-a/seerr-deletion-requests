<Project>
  <!-- Fixed release identity and untagged-build defaults. Tagged builds supply PluginVersion. -->
  <PropertyGroup>
    <PluginVersion Condition="'$(PluginVersion)' == ''">0.1.0.0</PluginVersion>
    <PluginGuid>3de88ba1-6d5c-49f5-854b-65a72f473f21</PluginGuid>
    <PluginDisplayName>Deletion queue</PluginDisplayName>
    <PluginOwner>someRandomDude-a</PluginOwner>
    <PluginCategory>General</PluginCategory>
    <PluginOverview>Consent-protected Seerr deletion proposals for Jellyfin.</PluginOverview>
    <PluginDescription>Integrated Jellyfin media/request removal proposals, private notifications and consent-protected Seerr-managed deletion. Seerr controls Arr targeting/files; authenticated local storage has no independent rollback witness.</PluginDescription>
    <PluginReleaseChannel>stable</PluginReleaseChannel>
    <PluginTargetAbi>12.2.0.0</PluginTargetAbi>
    <PluginSdkVersion>12.2.0</PluginSdkVersion>
    <Version>$(PluginVersion)</Version>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
  </PropertyGroup>
</Project>
