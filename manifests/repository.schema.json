{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deletion queue Jellyfin repository manifest",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["guid", "name", "description", "overview", "owner", "category", "versions"],
    "properties": {
      "guid": { "const": "3de88ba1-6d5c-49f5-854b-65a72f473f21" },
      "name": { "const": "Deletion queue" },
      "description": { "type": "string", "minLength": 1 },
      "overview": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "category": { "type": "string", "minLength": 1 },
      "versions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "changelog", "targetAbi", "sourceUrl", "checksum", "timestamp"],
          "properties": {
            "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
            "targetAbi": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "changelog": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/v[^/]+/DeletionQueue-[0-9.]+-(linux-x64|linux-arm64|win-x64)\\.zip$" },
            "checksum": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
